# Quire settings for Docker Compose. Copy to .env next to compose.yaml:
#   cp deploy/.env.example .env
# .env holds secrets: keep it out of git (the repository ignores it) and out of images.
# Lines starting with # are defaults shown for reference; remove the # to change one.

# ---- Access (required) ------------------------------------------------------------------
# The server refuses to start with no access token and no token in its database.
# Either set one here (a long random value: `openssl rand -hex 32`) or leave it empty and add
# named tokens before the first start:
#   docker compose run --rm --no-deps cloud quire tokens add laptop
QUIRE_TOKEN=

# Development only: run with no access control at all. Never set this on a server others can reach.
# QUIRE_INSECURE_NO_AUTH=1

# Most named tokens the server accepts (one per person or device).
# QUIRE_MAX_TOKENS=32

# Extra browser origins (comma separated, with scheme) that may call the API. The server's own
# address is always allowed.
# QUIRE_ALLOWED_ORIGINS=https://notes.example.com

# Lifetime of the single-use tickets that open event streams and live connections, in ms.
# QUIRE_TICKET_TTL_MS=60000

# ---- Network and TLS --------------------------------------------------------------------
# Host name for the tls profile (Caddy gets certificates for it; ports 80 and 443 must reach this machine).
# QUIRE_DOMAIN=notes.example.com

# Set to 1 when a reverse proxy (the tls profile, or your own) is in front: the client address
# is then taken from the first X-Forwarded-For entry. Leave 0 when clients connect directly.
# QUIRE_TRUST_PROXY=0

# Where Compose publishes the cloud server on this machine. Loopback by default; use 0.0.0.0
# to serve the network without the tls profile (then use a token and expect plain HTTP).
# QUIRE_BIND=127.0.0.1
# QUIRE_HOST_PORT=8787

# Port the server listens on inside the container (leave as is with Compose).
# QUIRE_PORT=8787

# ---- Local node (profile "local") -------------------------------------------------------
# Name of the local node in logs and history, and where it is published on this machine.
# QUIRE_LOCAL_DEVICE=local
# QUIRE_LOCAL_BIND=127.0.0.1
# QUIRE_LOCAL_PORT=8788
# Other settings for a node outside Compose (the local service sets the first three itself):
# QUIRE_MODE=local
# QUIRE_UPSTREAM=https://notes.example.com
# QUIRE_UPSTREAM_TOKEN=
# Replication interval and the longest wait between retries after errors, in ms.
# QUIRE_REPLICATE_MS=
# QUIRE_REPLICATE_MAX_BACKOFF_MS=

# ---- Storage and limits -----------------------------------------------------------------
# Set by the image: state lives in the volumes mounted here. Change only with the volumes.
# QUIRE_DATA_DIR=/data
# QUIRE_BACKUP_DIR=/backups
# Where the built web app is served from (set by the image).
# QUIRE_WEB_DIST=/app/apps/web/dist

# Watch the vault folder for edits made by other programs (1 on, 0 off).
# QUIRE_WATCH=1

# Largest note and largest attached file, in bytes.
# QUIRE_MAX_NOTE_BYTES=2097152
# QUIRE_MAX_FILE_BYTES=26214400

# ---- History and backups ----------------------------------------------------------------
# Quiet time that closes a change set (one burst of work), in ms.
# QUIRE_CHANGESET_GAP_MS=600000
# Compaction keeps every revision this many days.
# QUIRE_KEEP_ALL_DAYS=30

# ---- Logs -------------------------------------------------------------------------------
# One JSON line per request on standard output: debug, info, warn or error.
# QUIRE_LOG_LEVEL=info

# ---- Images (Compose) -------------------------------------------------------------------
# Image names come from variables so a registry mirror can replace the defaults.
# QUIRE_IMAGE=quire:latest
# QUIRE_NODE_IMAGE=node:22-bookworm-slim
# QUIRE_CADDY_IMAGE=caddy:2
# CA certificates (a file) for the image build behind a TLS-inspecting proxy; used only while building.
# QUIRE_BUILD_CA=

# This device's name for the server's own log lines and history (default: the container host name).
# QUIRE_DEVICE=
